{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "shopfloor-v12": {
      "i18n": {
        "sourceLocale": {
          "code": "en"
        },
        "locales": {
			"de": "src/locale/messages.de.xlf",
			"it": "src/locale/messages.it.xlf",
			"bg": "src/locale/messages.bg.xlf",
			"ro": "src/locale/messages.ro.xlf",
			"tr": "src/locale/messages.tr.xlf"
		}
      },
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "standalone": false
        },
        "@schematics/angular:directive": {
          "standalone": false
        },
        "@schematics/angular:pipe": {
          "standalone": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/shopfloor-v12",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": [],
            "serviceWorker": true,
            "ngswConfigPath": "ngsw-config.json"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "500kb",
                  "maximumError": "800kb"
                }
              ],
              "outputHashing": "all"
            },
            "de":{
              "localize" : ["de"]
            },
            "it":{
              "localize" : ["it"]
            },
            "bg":{
              "localize" : ["bg"]
            },
            "ro":{
              "localize" : ["ro"]
            },
            "tr":{
              "localize" : ["tr"]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "shopfloor-v12:build:production"
            },
            "de":{
              "buildTarget": "shopfloor-v12:build:de"
            },
            "it":{
              "buildTarget": "shopfloor-v12:build:it"
            },
            "bg":{
              "buildTarget": "shopfloor-v12:build:bg"
            },
            "ro":{
              "buildTarget": "shopfloor-v12:build:ro"
            },
            "tr":{
              "buildTarget": "shopfloor-v12:build:tr"
            },
            "development": {
              "buildTarget": "shopfloor-v12:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "shopfloor-v12:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/manifest.webmanifest"
            ],
            "styles": [
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }

    }
  },
  "cli": {
    "analytics": "11d3bc0d-e8ff-43e7-a166-2176be44b125"
  }
}
